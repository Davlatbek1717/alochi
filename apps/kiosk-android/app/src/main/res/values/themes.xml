<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full-screen, no action bar. The activity also drives immersive
         mode at runtime; this theme just avoids any chrome flash. -->
    <style name="Theme.AlojonKiosk" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowBackground">@color/ink</item>
    </style>
</resources>
