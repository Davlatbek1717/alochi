# ─────────────────────────────────────────────────────────────────────────────
#  A'lochi — environment template
#  Copy this file to .env (root + apps/api) and fill in real values before
#  bringing the stack up. Production builds will refuse to boot if any of
#  the keys marked [PROD-REQUIRED] are missing or still set to a placeholder.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Core ────────────────────────────────────────────────────────────────────
# [PROD-REQUIRED] Postgres connection string for the primary write DB.
DATABASE_URL=postgresql://postgres:password@localhost:5432/alochi?schema=public
# Optional — read replica for analytics / heavy reports. Falls back to
# DATABASE_URL when unset.
DATABASE_REPLICA_URL=

# Pino log level: trace | debug | info | warn | error | fatal. Default info.
LOG_LEVEL=info

# Listening port (defaults to 3001).
PORT=3001
NODE_ENV=development

# ─── Auth ────────────────────────────────────────────────────────────────────
# [PROD-REQUIRED] Both must be ≥32 chars of entropy. Generate with:
#   openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-32-characters-long

# [PROD-REQUIRED] Comma-separated list of origins allowed to call the API
# from a browser. Use the exact scheme + host + port you serve the frontend
# under; "*" is rejected because credentials: true is enabled. Examples:
#   ALLOWED_ORIGIN=https://app.alochi.uz,https://staging.alochi.uz
ALLOWED_ORIGIN=

# Device-trust JWT signing secret (Phase 13). Generate with:
#   openssl rand -base64 64
DEVICE_TOKEN_SECRET=

# ─── AI / speech ─────────────────────────────────────────────────────────────
# Get a free Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Azure cognitive services for pronunciation scoring.
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:ABCdef...
# Webhook URL the bot will be registered at. Use your public HTTPS host;
# leave blank if you run the bot in long-poll mode for local dev.
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/telegram/webhook

# ─── Microservices ───────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_MS=2000

# ─── PDPL / encryption ───────────────────────────────────────────────────────
# AES-256-GCM key for at-rest face vector encryption (PDPL §533).
# Generate with: openssl rand -base64 32
FACE_VECTOR_KEY=

# ─── ClickHouse (analytics) ──────────────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=alochi
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_DB=alochi_analytics

# ─── Redis (optional — sessions / cache / queues if used downstream) ────────
REDIS_URL=

# ─── Web frontend (Next.js) ──────────────────────────────────────────────────
# Public URL the browser uses to reach the API. Embedded into the bundle at
# build time, so it must be set BEFORE `pnpm --filter web run build`.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public Telegram bot username (no @) — used to deep-link parents from
# the student profile and letters page.
NEXT_PUBLIC_TELEGRAM_BOT=
