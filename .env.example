# ---- Database ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/alochi?schema=public

# ---- JWT ----
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-32-characters-long

# ---- Google Gemini AI (tutor / grader / explainer) ----
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# ---- Azure Speech (pronunciation scoring) ----
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus

# ---- Telegram Bot ----
TELEGRAM_BOT_TOKEN=1234567890:ABCdef...
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/telegram/webhook

# ---- AI Microservice ----
AI_SERVICE_URL=http://localhost:8000

# ---- Face vector encryption (PDPL §533 — at-rest AES-256-GCM) ----
# Generate with: openssl rand -base64 32
FACE_VECTOR_KEY=

# ---- App ----
PORT=3001
NODE_ENV=development

# ---- Next.js (web) ----
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- ClickHouse (Faza 4) ----
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=alochi
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_DB=alochi_analytics

# ---- ML service (Faza 4) ----
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_MS=2000

# ---- Security ----
# Device-trust JWT signing secret (Phase 13). Generate with: openssl rand -base64 64
DEVICE_TOKEN_SECRET=
