{
  "name": "alochi",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter api run start:dev",
    "dev:web": "pnpm --filter web run dev",
    "build": "pnpm --filter api run build && pnpm --filter web run build",
    "test": "pnpm --filter api test",
    "test:cov": "pnpm --filter api test:cov",
    "test:load": "pnpm --filter api test:load"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@prisma/client",
      "prisma",
      "bcrypt",
      "@nestjs/core",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "prisma": "5.22.0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  }
}
